# Copiar a .env y completar. El .env NO se sube al repo.

# --- Modelo de chat (model.py) ---
# Proveedores locales: ollama | lmstudio
MODEL_PROVIDER=ollama
# Para usar el modelo afinado alcanza con cambiar MODEL_NAME (por ejemplo amn-qwen3-lora).
MODEL_NAME=qwen3:4b

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
# Tamaño de contexto: el prompt más los esquemas de las tools tiene que entrar.
MODEL_NUM_CTX=8192
# 1 = el modelo razona antes de responder (más lento; la interfaz muestra el razonamiento).
MODEL_RAZONAMIENTO=0

# --- LM Studio ---
# Solo si MODEL_PROVIDER=lmstudio. MODEL_NAME es el identificador exacto del modelo cargado;
# el puerto se ve en la pestaña "Developer".
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# --- Gemini por API (opcional) ---
# Si están las dos variables, aparece la opción «Gemini» en el selector de modelo (Streamlit y
# consola: `python agente.py --modelo gemini`). Sin ellas, solo se usa el modelo local.
# Clave desde https://aistudio.google.com. Ojo: en el plan gratis Google puede usar lo que se envía.
GOOGLE_API_KEY=
# Identificador exacto del modelo de Gemini (el que figura en la documentación de Google).
GEMINI_MODEL=

# --- Embeddings del RAG (locales) ---
# Si EMBEDDINGS_PROVIDER queda vacío se usa el mismo proveedor que el chat.
# Ollama: `ollama pull bge-m3`. LM Studio: cargar un modelo de embeddings multilingüe.
EMBEDDINGS_PROVIDER=
EMBEDDINGS_MODEL=bge-m3

# --- Tavily (buscar_especificaciones_web) ---
# Clave desde https://app.tavily.com
TAVILY_API_KEY=

# --- Catálogo de la tienda ---
# De dónde sale el catálogo: prueba | csv | api
AMN_FUENTE_CATALOGO=prueba
AMN_CATALOGO_DB=datos/catalogo.sqlite

# Escenario A: catálogo real por la API de la tienda (AMN_FUENTE_CATALOGO=api)
# AMN_API_URL=https://api.amn.com.ar/api
AMN_API_URL=
# Los precios solo se ven con sesión iniciada. Iniciá sesión en la tienda, abrí las herramientas del
# navegador (F12 > Aplicación > Cookies) y copiá el VALOR de la cookie «__Secure-better-auth.session_token».
# Es una credencial: va solo en el .env, nunca al repo. La sesión vence: si la carga falla, copiala de nuevo.
AMN_API_TOKEN=
# Alternativa: la cookie completa, como nombre=valor (tiene prioridad sobre AMN_API_TOKEN).
AMN_API_COOKIE=
