# Copiar a .env.local. Estas variables las lee solo el servidor de Next (nunca llegan al navegador).

# Dónde está el servicio del agente (uv run python -m uvicorn servicio:app --port 8000)
AGENTE_URL=http://localhost:8000
# La misma clave que AGENTE_CLAVE del servicio, si se definió una
AGENTE_CLAVE=

# Solo desarrollo: 1 muestra el selector de modelo en el chat y lo reenvía al servicio
# (el servicio además exige AGENTE_MODELOS_PERMITIDOS). Dejar vacío o en 0 en producción.
NEXT_PUBLIC_MODO_DESARROLLO=0
